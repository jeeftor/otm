# Copy this file to .env and edit for your network.
#
# Example topology:
#   OPNsense router: 192.168.0.1
#   OTM app host:    192.168.0.10

# Web UI bind address. Use 127.0.0.1 for local-only access, or 0.0.0.0
# when serving the setup UI to other LAN devices.
OTM_WEB_ADDR=0.0.0.0:8080

# Optional web token. Set a real local token if OTM_WEB_ADDR is reachable
# from other hosts. Never commit your real token.
OTM_WEB_AUTH_TOKEN=change-this-local-token

# NetFlow UDP listener. OPNsense should export NetFlow v9 to this host/port.
OTM_NETFLOW_ADDR=0.0.0.0:2055
OTM_NETFLOW_ALLOWED_EXPORTERS=192.168.0.1
OTM_COLLECTOR_ADVERTISE_ADDR=192.168.0.10:2055

# Local data path used by the app.
OTM_DATA_DIR=./data
OTM_LOG_LEVEL=info

# OPNsense API settings. Store the real key/secret in files under ./secrets
# or another private path. Do not commit those secret files.
OTM_OPNSENSE_URL=https://192.168.0.1
OTM_OPNSENSE_API_KEY_FILE=./secrets/opnsense-key
OTM_OPNSENSE_API_SECRET_FILE=./secrets/opnsense-secret

# Useful for local/self-signed OPNsense certificates. Prefer installing a
# trusted certificate for long-term use.
OTM_OPNSENSE_INSECURE_SKIP_VERIFY=true
OTM_OPNSENSE_TIMEOUT=5s
